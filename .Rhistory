geom_line(data = data.frame(time = sort(unique(lv2$time)), K2 = aggregate(lv2, by = list(lv2$time), FUN = mean)$K2), aes(x = time, y = scale(K2), group = 1, color = "Smoothed", linetype = "Smoothed", linewidth = "Smoothed")) +  # Smoothed (blue)
